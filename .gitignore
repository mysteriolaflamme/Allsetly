# Environnement virtuel Python
.venv/
# Clés API - ne jamais partager ce fichier
.env
__pycache__/
*.pyc

# Model response cache (regenerable)
.cache/

# Test and linter caches
.pytest_cache/
.ruff_cache/

# Local documents and runtime data (never committed)
*.docx
data/

# Private manual tests (never committed)
/test/

# Evaluation intermediates (RESULTS.md is published)
eval/results/

# Local working files (never committed): scratch notes, ad-hoc root media
# (eval pairs live in eval/pairs/), local depth/relief photo sets.
/regarde.txt
/*.wav
/*.jpg
/nouvelles_paires/
/relief_casque/
/relief_ecran/
